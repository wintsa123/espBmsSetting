/*
  X-Content-Type-Options: nosniff
  Permissions-Policy: bluetooth=(self), local-network=(self), loopback-network=(self), local-network-access=(self)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/web-version.json
  Cache-Control: no-cache
/apk/latest.json
  Cache-Control: no-store
/firmware/firmware.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
